{
  "dependencies": {
    "concurrently": "^8.2.1",
    "react-router-dom": "^6.16.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "server": "npm start --prefix server",
    "client": "npm start --prefix cstclient",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server-install": "cd server && npm install",
    "cstclient-install": "cd cstclient && npm install",
    "full-install": "concurrently \"npm run server-install\" \"npm run cstclient-install\""
  }
}
