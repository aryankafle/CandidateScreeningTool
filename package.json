{
  "dependencies": {
    "@types/node": "^20.11.16",
    "concurrently": "^8.2.1",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "passport-google-oauth2": "^0.2.0",
    "passport-google-oidc": "^0.1.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "server": "npm start --prefix server",
    "client": "npm start --prefix CST",
